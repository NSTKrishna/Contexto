# =============================================================================
# Contexto — Universal Developer Context Manager
# Environment Variables Template
#
# Copy this file to .env and fill in the values.
# NEVER commit .env — only .env.example is version-controlled.
# =============================================================================

# ---------------------------------------------------------------------------
# Daemon Configuration (ctxd)
# ---------------------------------------------------------------------------

# Port for the ctxd REST API (default: 8942)
CTX_REST_PORT=8942

# Port for the MCP stdio server (leave empty to use stdio transport)
# CTX_MCP_PORT=

# Path to the SQLite database file
# Default: ~/.ctx/contexto.db
CTX_DB_PATH=~/.ctx/contexto.db

# Path where the daemon writes its auth token (permissions: 0600)
# Default: ~/.ctx/auth_token
CTX_AUTH_TOKEN_PATH=~/.ctx/auth_token

# ---------------------------------------------------------------------------
# Logging & Observability
# ---------------------------------------------------------------------------

# Log level: error | warn | info | debug | trace
# Use "info" for production, "debug" for development
CTX_LOG_LEVEL=info

# Log format: pretty | json | compact
# Use "json" for structured log ingestion (e.g. Datadog, Loki)
CTX_LOG_FORMAT=pretty

# ---------------------------------------------------------------------------
# Context Capture Behavior
# ---------------------------------------------------------------------------

# Maximum number of characters to capture per terminal event
CTX_MAX_TERMINAL_EVENT_SIZE=8192

# Maximum file size (in bytes) to store a snapshot for (default: 51200 = 50KB)
# Files larger than this skip AST snapshots and generate LLM summaries only
CTX_MAX_SNAPSHOT_FILE_SIZE=51200

# Batch write interval in milliseconds (ring buffer flush frequency)
CTX_BATCH_WRITE_INTERVAL_MS=500

# Maximum events to accumulate before forcing a batch flush
CTX_BATCH_MAX_EVENTS=50

# ---------------------------------------------------------------------------
# AI / LLM Configuration (Phase 6+)
# ---------------------------------------------------------------------------

# API key for LLM provider (used only for Layer 3 project summaries)
# CTX_LLM_API_KEY=

# LLM provider: openai | anthropic | ollama (default: ollama for local)
# CTX_LLM_PROVIDER=ollama

# Ollama model for local summarization (default: llama3.2)
# CTX_OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Development / Debug Overrides
# ---------------------------------------------------------------------------

# Set to "true" to disable auth token check (DEVELOPMENT ONLY — NEVER IN PROD)
CTX_DISABLE_AUTH=false

# Set to "true" to enable verbose SQL query logging
CTX_LOG_SQL=false
